APP_NAME=Kanvigo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Uploaded attachments. The disk defaults to FILESYSTEM_DISK; each attachment
# records the disk it was stored on, so changing this leaves existing files
# reachable. Raising the size cap (in KB) means raising PHP's upload_max_filesize
# and post_max_size, and any reverse-proxy body limit, to match.
ATTACHMENTS_DISK=local
# ATTACHMENTS_DIRECTORY=attachments
# ATTACHMENTS_MAX_SIZE=12288
# ATTACHMENTS_SIGNED_URL_TTL=30
# ATTACHMENTS_GHOSTSCRIPT=gs

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Seed a default admin (all permissions). Both email and password are required —
# seeding fails without them, since registration is invitation-only. The name is
# optional and defaults to "Admin".
ADMIN_NAME="Admin"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Application behaviour. Depth counts the root task as level 1; auto-archive is
# the default number of days a Done task waits, which projects may override and
# 0 disables; the live-updates interval is how often a board re-polls, in
# seconds.
# KANVIGO_TASK_MAX_DEPTH=3
# KANVIGO_AUTO_ARCHIVE_DAYS=30
# KANVIGO_LIVE_UPDATES_INTERVAL=15

# Export limits: the longest edge images are scaled to before being inlined, the
# byte budget after which further images degrade to links, and the item count
# above which a whole-project export is refused (it is built in the request).
# KANVIGO_EXPORT_IMAGE_MAX_EDGE=1024
# KANVIGO_EXPORT_INLINE_BUDGET=5242880
# KANVIGO_EXPORT_MAX_PROJECT_ITEMS=2000

# Audit trail. Retention prunes delivered outbox rows only, and 0 keeps them
# forever. The PII salt falls back to APP_KEY; rotating it invalidates every
# pseudonymous token already published, which is the crypto-shredding lever.
# AUDIT_OUTBOX_RETENTION_DAYS=30
# AUDIT_PII_TOKEN_SALT=

# Encrypts backup archives. Leave empty and the archive is unencrypted — note it
# contains .env, and therefore your APP_KEY.
# BACKUP_ARCHIVE_PASSWORD=

# The permission layer. The system role is break-glass: it implicitly holds every
# permission in every scope, and is meant to be switched off once real
# administrator accounts exist. Leave the role cap empty for no limit.
# DELEGATED_PERMISSIONS_SYSTEM_ENABLED=true
# DELEGATED_PERMISSIONS_MAX_ROLES_PER_SCOPE=
# DELEGATED_PERMISSIONS_TABLE_PREFIX=

# Passkey user handles are derived from this; it falls back to APP_KEY. Changing
# either invalidates existing passkeys.
# PASSKEYS_USER_HANDLE_SECRET=

# Version reported by the generated API documentation.
# API_VERSION=1.0.0
